---
import LiquidGlassLess from "@components/common/LiquidGlassLess.astro";
import { getEntries } from "@lib/contentParser";
import type { BlogEntry, PagesEntry } from "@/types";

const { limit = 8 } = Astro.props as { limit?: number };
const allPosts = (await getEntries("blog")) as BlogEntry[];
const pages = (await getEntries("pages")) as PagesEntry[];
const titleMap = Object.fromEntries(
  [...allPosts,...pages].map((p) => [p.id, p.data.title])
);
---

<section class="rounded-lg pt-3">
  <div class="flex items-center justify-between mb-4 px-3">
    <h3 class="text-xl font-bold text-txt-p dark:text-darkmode-txt-p">
      最近留言
    </h3>
  </div>
  <ul id="recent-comments-list" class="space-y-1"></ul>
</section>

<script define:vars={{
  twikooEnvId: import.meta.env.PUBLIC_TWIKOO_ENV_ID || "",
  limit,
  titleMap
}}>
  const SAFE_PROTOCOLS = ['https:', 'http:'];
  function sanitizeUrl(raw) {
    if (!raw) return '#';
    try {
      const u = new URL(raw, location.href);
      return SAFE_PROTOCOLS.includes(u.protocol) ? u.href : '#';
    } catch { return '#'; }
  }

  let list = document.getElementById("recent-comments-list");
  const maxLen = 100;

  function showLoading() {
    if (!list) return;
    list.textContent = '';
    list.setAttribute('aria-busy', 'true');
    const li = document.createElement('li');
    li.className = 'py-4';
    const wrapper = document.createElement('div');
    wrapper.className = 'flex items-center justify-center gap-2 text-slate-500 dark:text-slate-200';
    const spinner = document.createElement('span');
    spinner.className = 'inline-block w-5 h-5 border-2 border-slate-400 border-t-transparent rounded-full animate-spin';
    const label = document.createElement('span');
    label.textContent = '正在加载留言…';
    wrapper.appendChild(spinner);
    wrapper.appendChild(label);
    li.appendChild(wrapper);
    list.appendChild(li);
  }

  function showError(msg) {
    if (!list) return;
    list.textContent = '';
    list.removeAttribute('aria-busy');
    const li = document.createElement('li');
    li.className = 'py-4';
    const inner = document.createElement('div');
    inner.className = 'text-center text-red-600 dark:text-red-400';
    inner.textContent = msg || '评论获取失败，请稍后重试。';
    li.appendChild(inner);
    list.appendChild(li);
    const btn = document.getElementById("rc-retry-btn");
    if (btn) { btn.addEventListener("click", load, { once: true }); }
  }

  function stripHtml(s) {
    try {
      return (s || "").replace(/<[^>]*>/g, "").trim();
    } catch (e) {
      return "";
    }
  }

  function pathFromUrl(u) {
    try {
      if (!u || u.indexOf("/") === -1) return u || "";
      const segs = u.split("/");
      const last = segs[segs.length - 1];
      return decodeURIComponent(last) || last;
    } catch (e) {
      return u || "";
    }
  }

  function ensureTwikoo(cb) {
    if (window.twikoo) { cb(); return; }
    const s = document.createElement("script");
    s.src = "https://cdn.jsdelivr.net/npm/twikoo@1.6.44/dist/twikoo.min.js";
    s.async = true;
    s.onload = cb;
    s.onerror = () => { showError("评论系统加载失败，请稍后重试。"); };
    document.body.appendChild(s);
  }

  function render(items) {
    if (!list) return;
    list.textContent = '';
    list.removeAttribute('aria-busy');
    if (!items || items.length === 0) {
      const li = document.createElement('li');
      li.className = 'text-slate-500 dark:text-slate-200 text-center';
      li.textContent = '还没有留言哦';
      list.appendChild(li);
      return;
    }
    items.forEach((it, index) => {
      const rawUrl = it.url || it.link || "#";
      const safeUrl = sanitizeUrl(rawUrl);
      const path = pathFromUrl(rawUrl);
      const title = titleMap[path] || path;
      const rawComment = it.comment || it.content || "";
      const full = stripHtml(rawComment);
      const short = full.length > maxLen ? full.slice(0, maxLen) + "…" : full;
      const nick = it.nick || it.nickname || "匿名";
      const avatar = it.avatar || it.avatarUrl || "";
      const dateStr = (() => {
        try { return new Date(it.created || Date.now()).toLocaleString(); }
        catch { return ""; }
      })();

      const li = document.createElement('li');
      li.className = "group rounded-[25px] hover:bg-primary/5 transition-all duration-300 intersect:animate-fadeUp opacity-0 p-3 hover:bg-orange-500 dark:hover:bg-orange-500 hover:text-darkmode-txt-light [&_*]:hover:text-darkmode-txt-p";
      li.style.animationDelay = `${index * 200}ms`;

      const a = document.createElement('a');
      a.className = 'no-underline hover:text-primary';
      a.href = safeUrl;

      const flex = document.createElement('div');
      flex.className = 'text-txt-light dark:text-darkmode-txt-light flex items-center gap-2 mt-1 h-8';

      const avatarWrap = document.createElement('span');
      avatarWrap.className = 'glass w-9 h-9 rounded-full overflow-hidden hover:rotate-12 duration-300';
      const img = document.createElement('img');
      img.src = sanitizeUrl(avatar);
      img.alt = nick;
      img.className = 'w-9 h-9 rounded-full';
      avatarWrap.appendChild(img);

      const nameCol = document.createElement('div');
      nameCol.className = 'flex flex-col justify-center leading-tight h-8';
      const nameSpan = document.createElement('span');
      nameSpan.className = 'text-base text-txt-p dark:text-darkmode-txt-p';
      nameSpan.textContent = nick;
      const dateSpan = document.createElement('span');
      dateSpan.className = 'text-xs text-slate-500 dark:text-slate-200';
      dateSpan.textContent = dateStr;
      nameCol.appendChild(nameSpan);
      nameCol.appendChild(dateSpan);

      flex.appendChild(avatarWrap);
      flex.appendChild(nameCol);

      const commentDiv = document.createElement('div');
      commentDiv.className = 'text-[#3e5f6a] dark:text-darkmode-txt-p leading-7 line-clamp-2 font-semibold mt-3';
      commentDiv.textContent = short;
      commentDiv.title = full;

      const sourceDiv = document.createElement('div');
      sourceDiv.className = 'text-sm italic opacity-0 group-hover:opacity-100 text-slate-600 dark:text-slate-100/50 border-t border-slate-300/30 dark:border-darkmode-border/30 pt-1 text-right transition-opacity duration-300';
      sourceDiv.textContent = '来自：' + title;

      a.appendChild(flex);
      a.appendChild(commentDiv);
      a.appendChild(sourceDiv);
      li.appendChild(a);
      list.appendChild(li);
    });
  }

  function load() {
    list = document.getElementById("recent-comments-list");
    if (!list) return;
    if (!twikooEnvId) {
      showError("留言模块未加载，Twikoo envId 未配置。");
      return;
    }
    showLoading();
    ensureTwikoo(() => {
      if (!window.twikoo) {
        showError("评论系统初始化失败");
        return;
      }
      window.twikoo.getRecentComments({ envId: twikooEnvId, pageSize: limit })
        .then((res) => {
          const arr = res?.comments || res || [];
          render(arr);
        })
        .catch((err) => {
          console.error('获取最近评论失败', err);
          showError("评论获取失败，请稍后重试。");
        });
    });
  }

  document.addEventListener("astro:page-load", load);
</script>